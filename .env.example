# ── Scraper Pro — server env (Vercel Project Settings → Environment Variables) ──
# Everything here is OPTIONAL: keys can also be entered in the UI (saved in the
# browser). Env values, when present, always WIN over UI values.

# Optional shared password to gate the whole tool (leave empty to disable).
APP_PASSWORD=

# ── Background removal (best-available chain; falls back to FREE local model) ──
# Replicate (highest quality, ~$0.002-0.01/img) — token from replicate.com/account
REPLICATE_API_TOKEN=
# remove.bg commercial API (optional)
REMOVEBG_API_KEY=
# Local ONNX model choice: isnet-general-use (default, best) | silueta | u2netp | u2net
BG_LOCAL_MODEL=isnet-general-use

# ── AI enrichment (name/description/translation/classification) ──
# Claude does the copywriting + vision (recommended). OpenAI is the fallback.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Extraction: Firecrawl (full galleries / JS-heavy sites + web search fallback) ──
FIRECRAWL_API_KEY=

# ── Web image search by product name (optional) ──
# Google Programmable Search (Custom Search JSON API), image mode — cleanest.
# GOOGLE_CSE_KEY = API key from console.cloud.google.com (Custom Search API enabled)
# GOOGLE_CSE_CX  = search-engine ID from programmablesearchengine.google.com (Image search ON, "search entire web")
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# ── Target store (kiss-play adapter) ──
# The store API base + the shared import token you set on the store worker
# (wrangler secret put SCRAPER_IMPORT_TOKEN).
STORE_BASE=https://adult-store-api.bawaya-2019.workers.dev
STORE_IMPORT_TOKEN=

# Allow scraping private/internal hosts (leave unset in production; SSRF guard).
# SCRAPER_ALLOW_PRIVATE=1
